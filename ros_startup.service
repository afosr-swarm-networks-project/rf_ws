[Unit]
Description=Launch ROS Nodes on Startup
After=network.target

[Service]
Type=simple
User=autonomypark
WorkingDirectory=/home/autonomypark/unitree_ws
ExecStart=/bin/bash -c "export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp && source /opt/ros/humble/setup.bash && source /home/autonomypark/unitree_ws/install/setup.bash && ros2 launch go1_bringup go1_bringup_launch.py namespace:=P1"
ExecStartPre=/bin/sleep 15
Restart=no
RestartSec=5

[Install]
WantedBy=multi-user.target
